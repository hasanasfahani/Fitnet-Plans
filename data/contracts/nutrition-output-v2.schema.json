{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fitnet.nutrition.output.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_version", "nutrition_summary", "days", "weekly_grocery_list", "repeat_instruction", "safety_notes"],
  "properties": {
    "program_version": { "const": "fitnet.nutrition.output.v2" },
    "nutrition_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "daily_calorie_target", "daily_macro_targets", "meals_per_day", "nutrition_rationale"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "daily_calorie_target": { "type": "number", "minimum": 1000 },
        "calculation_version": { "type": "string", "minLength": 1 },
        "target_is_estimate": { "type": "boolean" },
        "estimated_resting_calories": { "type": "number", "minimum": 0 },
        "estimated_maintenance_calories": { "type": "number", "minimum": 0 },
        "activity_level": { "type": "string", "minLength": 1 },
        "goal_adjustment_calories": { "type": "number" },
        "daily_macro_targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protein_g", "carbs_g", "fat_g", "fiber_g"],
          "properties": {
            "protein_g": { "type": "number", "minimum": 0 },
            "carbs_g": { "type": "number", "minimum": 0 },
            "fat_g": { "type": "number", "minimum": 0 },
            "fiber_g": { "type": "number", "minimum": 0 }
          }
        },
        "meals_per_day": { "type": "integer", "minimum": 2, "maximum": 6 },
        "nutrition_rationale": { "type": "string", "minLength": 1 }
      }
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day_index", "day_name", "meals", "daily_totals"],
        "properties": {
          "day_index": { "type": "integer", "minimum": 1, "maximum": 7 },
          "day_name": { "type": "string", "minLength": 1 },
          "meals": { "type": "array", "minItems": 2, "maxItems": 6 },
          "daily_totals": { "type": "object" }
        }
      }
    },
    "weekly_grocery_list": { "type": "array", "minItems": 1 },
    "repeat_instruction": { "type": "string", "minLength": 1 },
    "safety_notes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
