{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fitnet.nutrition.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["nutrition_days"],
  "properties": {
    "nutrition_days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day_index", "meals", "daily_totals"],
        "properties": {
          "day_index": { "type": "integer", "minimum": 1 },
          "meals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "meal_slot",
                "meal_name",
                "food_ids",
                "calories",
                "protein_g",
                "carbs_g",
                "fat_g",
                "notes"
              ],
              "properties": {
                "meal_slot": { "type": "string", "minLength": 1 },
                "meal_name": { "type": "string", "minLength": 1 },
                "food_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "calories": { "type": "integer", "minimum": 0 },
                "protein_g": { "type": "integer", "minimum": 0 },
                "carbs_g": { "type": "integer", "minimum": 0 },
                "fat_g": { "type": "integer", "minimum": 0 },
                "notes": { "type": "string" }
              }
            }
          },
          "daily_totals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["calories", "protein_g", "carbs_g", "fat_g"],
            "properties": {
              "calories": { "type": "integer", "minimum": 0 },
              "protein_g": { "type": "integer", "minimum": 0 },
              "carbs_g": { "type": "integer", "minimum": 0 },
              "fat_g": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
