{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fitnet.workout.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_days"],
  "properties": {
    "coaching_rationale": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "plan_days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day_index", "day_name", "exercises"],
        "properties": {
          "day_index": { "type": "integer", "minimum": 1 },
          "day_name": { "type": "string", "minLength": 1 },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot_id", "exercise_id", "sets", "reps", "rest_seconds", "notes"],
              "properties": {
                "slot_id": { "type": "string", "minLength": 1 },
                "exercise_id": { "type": "integer", "minimum": 1 },
                "sets": { "type": "integer", "minimum": 1 },
                "reps": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "rest_seconds": { "type": "integer", "minimum": 0 },
                "notes": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
