{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300,
      "includeFiles": "data/**"
    },
    "api/internal-logs.js": {
      "maxDuration": 10
    },
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{scripts,assets,data,vendor}/**"
    }
  },
  "rewrites": [
    { "source": "/internal", "destination": "/internal/index.html" },
    { "source": "/api/render-pdf", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/internal",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
      ]
    }
  ]
}
